<?xml version="1.0" encoding="utf-8"?>
<!--
  The adaptive icon's background layer: the icon's plate.

  This is the source SVG's `t2Bg` linear gradient (#FFFFFF -> #F1F4F9, top to
  bottom) expressed as a shape so it stays a vector at every density instead of
  being baked into five PNGs.

  `angle="270"` is top -> bottom in Android's <gradient> (angles run counter-
  clockwise from 3 o'clock: 0 = left->right, 270 = top->bottom).

  The plate is intentionally **square with no rounded corners**: the launcher
  owns the mask. A pre-rounded plate would be rounded twice and the artwork
  would shrink inside it.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#FFFFFF"
        android:endColor="#F1F4F9"
        android:type="linear" />
</shape>
